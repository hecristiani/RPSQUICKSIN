  "LISTA 2": [["El ",0],["río pasa",1],[" a ",0],["través",1],[" del ",0],["campo",1],[" de ",0],["trigo",1],[".\n",0],["Para tener fama",1],[" hay que ",0],["tener suerte",1],[".\n",0],["El ",0],["hombre alto logró",1],[" una ",0],["buena marca",1],[".\n",0],["Hay",1],[" un ",0],["montón",1],[" de ",0],["platos sucios",1],[" en la ",0],["mesa",1],[".\n",0],["Qué feliz",1],[" es el ",0],["niño",1],[" cuando ",0],["juega",1],[" en el ",0],["parque",1],[".\n",0],["La ",0],["playa",1],[" se ",0],["seca",1],[" si ",0],["baja mucho",1],[" el ",0],["agua",1],["."]],
  "LISTA 3": [["Todos",1],[" los ",0],["niños",1],[" se ",0],["ríen",1],[" cuando ",0],["van",1],[" al ",0],["circo.\n",1],["La ",0],["brisa",1],[" ",0],["llegó",1],[" hasta el ",0],["otro",1],[" ",0],["lado",1],[" de la ",0],["costa",1],[".\n",0],["El ",0],["chico",1],[" ",0],["joven",1],[" es el ",0],["autor",1],[" del ",0],["libro",1],[" ",0],["nuevo",1],[".\n",0],["La ",0],["joven madre hizo",1],[" una ",0],["canción",1],[" para su ",0],["niño.\n",1],["Una ",0],["chispa quemó",1],[" el ",0],["mantel justo",1],[" en el ",0],["medio",1],[".\n",0],["Una ",0],["gota",1],[" de ",0],["leche cayó",1],[" por el ",0],["borde",1],[" de la ",0],["mesa",1],["."]],
  "LISTA 4": [["El ",0],["pobre chico",1],[" ",0],["perdió ",1],["el ",0],["tren",1],[" de ",0],["nuevo",1],[".\n",0],["La",0],[" chica quiere ",1],["una",0],[" joya ",1],["de",0],[" oro blanco.\n",1],["Un ",0],["buen jabón deja",1],[" la ",0],["piel suave",1],[".\n",0],["Cubrió",1],[" la ",0],["mesa",1],[" con una ",0],["gran tela rosa",1],[".\n",0],["El ",0],["viejo reloj",1],[" de la ",0],["pared marca",1],[" las ",0],["once",1],[".\n",0],["Un ",0],["trapo seca",1],[" el ",0],["agua",1],[" que ",0],["hay",1],[" en la ",0],["mesa",1],["."]],
  "LISTA 5": [["Los ",0],["ojos",1],[" de la ",0],["chica tienen",1],[" un ",0],["gran brillo",1],[".\n",0],["Tome",1],[" la ",0],["otra senda",1],[" para ",0],["llegar al lago",1],[".\n",0],["El ",0],["niño",1],[" fue a ",0],["jugar",1],[" a ",0],["casa",1],[" de su ",0],["primo",1],[".\n",0],["El ",0],["mago",1],[" ",0],["tiene",1],[" un ",0],["ratón dentro",1],[" de la ",0],["caja",1],[".\n",0],["La ",0],["madre batió",1],[" el ",0],["huevo",1],[" para ",0],["hacer ",1],["la ",0],["cena.\n",1],["Oyó un ",0],["coche",1],[" ",0],["llegar",1],[" a la ",0],["puerta",1],[" de ",0],["casa",1],["."]],
  "LISTA 6": [["El ",0],["color gris está muy",1],[" de ",0],["moda",1],[".\n",0],["La ",0],["chica joven ",1],["se ",0],["quitó",1],[" el ",0],["gorro",1],[" de ",0],["lana",1],[".\n",0],["La ",0],["carne fría ",1],["es ",0],["apta",1],[" para ",0],["este menú",1],[".\n",0],["Vivió cinco años ",1],["con ",0],["aquel perro",1],[".\n",0],["Los ",0],["tacos",1],[" se ",0],["hunden fácil ",1],["en el ",0],["césped blando",1],[".\n",0],["El ",0],["plazo venció ",1],["el ",0],["primer día ",1],["de ",0],["mayo.",1]],
  "LISTA 7": [["El ",0],["camión tuvo ",1],["que ",0],["parar",1],[" por la ",0],["fuerte lluvia",1],[".\n",0],["Los ",0],["niños toman sopa ",1],["de ",0],["pollo",1],[" por la ",0],["noche",1],[".\n",0],["El ",0],["reloj ",1],["de la ",0],["plaza marcó ",1],["las ",0],["cuatro",1],[" de la ",0],["tarde",1],[".\n",0],["La ",0],["blusa blanca está sucia ",1],["de ",0],["barro",1],[".\n",0],["No es ",0],["fácil tener ",1],["una ",0],["tierra fértil ",1],["sin ",0],["agua",1],[".\n",0],["Dejé",1],[" su ",0],["vaso dentro ",1],["de la ",0],["bolsa negra",1],["."]],
  "LISTA 8": [["El ",0],["fruto",1],[" del ",0],["nogal",1],[" es de ",0],["color marrón claro",1],[".\n",0],["Llevó",1],[" a sus ",0],["dos hijos",1],[" a ",0],["jugar",1],[" al ",0],["parque",1],[".\n",0],["La ",0],["chica",1],[" era ",0],["buena",1],[" con ",0],["toda ",1],["la ",0],["gente",1],[" de la ",0],["tienda",1],[".\n",0],["Vino pronto",1],[" cuando ",0],["oyó sonar",1],[" el ",0],["timbre",1],[".\n",0],["Una ",0],["taza",1],[" de ",0],["leche",1],[" es ",0],["agua",1],[" en su ",0],["mayor parte",1],[".\n",0],["El ",0],["bebé",1],[" se ",0],["mete",1],[" el ",0],["pie dentro",1],[" de la ",0],["boca",1],["."]],
};

const ac = new Array(7).fill(0);
let pausado=false, calState={1:false,2:false}, listaActual=null, modoActual="Auriculares";
const audioPlayer=document.getElementById('audio-player');
const calPlayer=document.getElementById('cal-player');

Object.keys(LISTAS).forEach(nombre=>{
  const d=document.createElement('div'); d.textContent=nombre;
  d.onclick=()=>{
    listaActual=nombre;
    document.getElementById('sel-badge').textContent=nombre;
    document.querySelectorAll('#listbox div').forEach(x=>x.classList.remove('selected'));
    d.classList.add('selected');
    const box=document.getElementById('text-box'); box.innerHTML='';
    LISTAS[nombre].forEach(([txt,red])=>{
      if(red){const s=document.createElement('span');s.className='kw';s.textContent=txt;box.appendChild(s);}
      else box.appendChild(document.createTextNode(txt));
    });
    ocultarMensajes();
  };
  document.getElementById('listbox').appendChild(d);
});

document.querySelectorAll('.modo-group input[type=radio]').forEach(r=>{
  r.addEventListener('change',()=>{
    modoActual=r.value;
    document.querySelectorAll('.modo-group label').forEach(l=>l.classList.remove('active'));
    r.parentElement.classList.add('active');
  });
});

const tabla=document.getElementById('resp-table');
for(let g=1;g<=6;g++){
  const tr=document.createElement('tr');
  const tdl=document.createElement('td'); tdl.className='lbl'; tdl.textContent='Oración '+g+':'; tr.appendChild(tdl);
  for(let o=0;o<=5;o++){
    const td=document.createElement('td');
    const btn=document.createElement('button');
    btn.className='resp-btn'; btn.textContent=o; btn.id='rb-'+g+'-'+o;
    btn.addEventListener('click',()=>{
      for(let i=0;i<=5;i++) document.getElementById('rb-'+g+'-'+i).className='resp-btn'+(i===o?' active':'');
      ac[g]=o;
    });
    td.appendChild(btn); tr.appendChild(td);
  }
  tabla.appendChild(tr);
}

function mostrarStatus(msg){const e=document.getElementById('status-msg');e.textContent=msg;e.style.display='block';document.getElementById('error-msg').style.display='none';}
function mostrarError(msg){const e=document.getElementById('error-msg');e.textContent=msg;e.style.display='block';document.getElementById('status-msg').style.display='none';}
function ocultarMensajes(){document.getElementById('status-msg').style.display='none';document.getElementById('error-msg').style.display='none';}

function reproducir(){
  if(!listaActual){mostrarError('Seleccioná una lista primero.');return;}
  const num=listaActual.replace('LISTA ','');
  const url=urlAudio(modoActual, num);
  mostrarStatus('Cargando audio...');
  audioPlayer.src=url;
  audioPlayer.play()
    .then(()=>ocultarMensajes())
    .catch(()=>mostrarError('No se pudo reproducir. Verificá la conexión a internet.'));
  pausado=false;
}

function pausaReanudar(){
  if(!audioPlayer.src)return;
  if(!pausado){audioPlayer.pause();pausado=true;}
  else{audioPlayer.play();pausado=false;}
}

function toggleCal(n){
  const btn=document.getElementById('btn-cal'+n);
  if(!calState[n]){
    const url = n===1 ? CAL1 : CAL2;
    mostrarStatus('Cargando tono de calibración...');
    calPlayer.src=url;
    calPlayer.play()
      .then(()=>ocultarMensajes())
      .catch(()=>mostrarError('No se pudo reproducir el tono de calibración.'));
    calState[n]=true; btn.classList.add('playing'); btn.textContent='■ CAL '+n;
  }else{
    calPlayer.pause(); calPlayer.currentTime=0;
    calState[n]=false; btn.classList.remove('playing'); btn.textContent='CAL '+n;
    ocultarMensajes();
  }
}

function calcular(){
  let t=0; for(let g=1;g<=6;g++) t+=ac[g];
  document.getElementById('res1').textContent=(19.5-t).toFixed(1);
  document.getElementById('res2').textContent=(24.5-t).toFixed(1);
}
</script>
</body>
</html>
