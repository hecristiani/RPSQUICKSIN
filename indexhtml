<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RPS Quick Sin — Habla en Ruido</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #f0f2f5; color: #1a1a2e; font-size: 14px; }
  header { background: #1a1a2e; color: #fff; padding: 14px 24px; display: flex; align-items: center; gap: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.3); }
  header h1 { font-size: 17px; font-weight: 600; }
  header span { font-size: 12px; color: #aab; margin-left: auto; }
  .app { display: grid; grid-template-columns: 240px 1fr; gap: 16px; padding: 16px; max-width: 1100px; margin: 0 auto; }
  .panel { background: #fff; border: 1px solid #dde1ea; border-radius: 10px; padding: 14px; }
  .section-title { font-size: 11px; font-weight: 600; color: #888; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px; }
  .sel-badge { background: #f0f2f5; border: 1px solid #dde1ea; border-radius: 6px; padding: 7px 10px; font-weight: 700; font-size: 13px; min-height: 32px; margin-bottom: 12px; }
  .listbox { border: 1px solid #dde1ea; border-radius: 8px; overflow: hidden; margin-bottom: 12px; }
  .listbox div { padding: 8px 12px; cursor: pointer; font-size: 13px; border-bottom: 1px solid #f0f2f5; }
  .listbox div:last-child { border-bottom: none; }
  .listbox div:hover { background: #f0f2f5; }
  .listbox div.selected { background: #1a1a2e; color: #fff; font-weight: 600; }
  .btn { display: block; width: 100%; padding: 9px 12px; border-radius: 7px; border: 1px solid #dde1ea; background: #fff; color: #1a1a2e; font-size: 13px; cursor: pointer; margin-bottom: 7px; text-align: left; font-family: inherit; }
  .btn:hover { background: #f0f2f5; }
  .btn-play { background: #1a1a2e; color: #fff; border-color: #1a1a2e; }
  .btn-play:hover { background: #2d2d4e; }
  .btn-pause { background: #444; color: #fff; border-color: #444; }
  .btn-pause:hover { background: #222; }
  .divider { height: 1px; background: #eee; margin: 12px 0; }
  .modo-group { display: flex; flex-direction: column; gap: 6px; margin-top: 4px; }
  .modo-group label { display: flex; align-items: center; gap: 8px; font-size: 13px; cursor: pointer; padding: 6px 10px; border-radius: 7px; border: 1px solid #dde1ea; }
  .modo-group label:hover { background: #f0f2f5; }
  .modo-group label.active { background: #1a1a2e; color: #fff; border-color: #1a1a2e; }
  .modo-group input[type=radio] { display: none; }
  .cal-btns { display: flex; gap: 8px; margin-top: 4px; }
  .btn-cal { flex: 1; padding: 8px; border-radius: 7px; border: none; background: #5a3000; color: #fff; cursor: pointer; font-size: 13px; font-weight: 600; font-family: inherit; }
  .btn-cal:hover { background: #3a1e00; }
  .btn-cal.playing { background: #b00020; }
  .text-box { background: #f8f9fb; border: 1px solid #dde1ea; border-radius: 8px; padding: 16px; min-height: 160px; font-size: 16px; line-height: 2.2; white-space: pre-wrap; word-break: break-word; }
  .kw { color: #c0392b; font-weight: 700; }
  .resp-table { width: 100%; border-collapse: collapse; }
  .resp-table td { padding: 3px 4px; }
  .resp-table .lbl { font-size: 12px; color: #666; text-align: right; padding-right: 10px; white-space: nowrap; width: 80px; }
  .resp-btn { width: 38px; height: 34px; border: 1px solid #bbb; border-radius: 6px; background: #fff; cursor: pointer; font-size: 13px; font-weight: 600; font-family: inherit; color: #333; }
  .resp-btn:hover { background: #e8e8e8; }
  .resp-btn.active { background: #5F5E5A; color: #fff; border-color: #2C2C2A; }
  .results-row { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; margin-top: 12px; }
  .btn-calc { background: #1a7a1a; color: #fff; border: none; padding: 10px 22px; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer; font-family: inherit; }
  .btn-calc:hover { background: #145a14; }
  .res-card { background: #f0f2f5; border-radius: 8px; padding: 8px 18px; min-width: 110px; }
  .res-label { font-size: 11px; color: #888; margin-bottom: 2px; }
  .res-val { font-size: 24px; font-weight: 700; color: #b00020; }
  #status-msg { display: none; background: #e8f4fd; border: 1px solid #90caf9; border-radius: 8px; padding: 10px 14px; font-size: 12px; color: #1565c0; margin-top: 8px; }
  #error-msg { display: none; background: #fff3cd; border: 1px solid #ffc107; border-radius: 8px; padding: 10px 14px; font-size: 12px; color: #856404; margin-top: 8px; }
</style>
</head>
<body>
<header>
  <div>🎧</div>
  <h1>RPS Quick Sin — Habla en Ruido</h1>
  <span>Audiología clínica</span>
</header>
<div class="app">
  <div style="display:flex;flex-direction:column;gap:12px;">
    <div class="panel">
      <div class="section-title">Lista seleccionada</div>
      <div class="sel-badge" id="sel-badge">—</div>
      <div class="section-title">Listas</div>
      <div class="listbox" id="listbox"></div>
      <button class="btn btn-play" onclick="reproducir()">▶  Reproducir</button>
      <button class="btn btn-pause" onclick="pausaReanudar()">⏸  Pausa / Reanudar</button>
      <div id="status-msg"></div>
      <div id="error-msg"></div>
    </div>
    <div class="panel">
      <div class="section-title">Modo</div>
      <div class="modo-group">
        <label class="active"><input type="radio" name="modo" value="Auriculares" checked> Auriculares</label>
        <label><input type="radio" name="modo" value="Campo Libre"> Campo libre</label>
        <label><input type="radio" name="modo" value="Campo Libre SNR=0dB"> Campo libre SNR=0dB</label>
      </div>
    </div>
    <div class="panel">
      <div class="section-title">Tonos de calibración</div>
      <div class="cal-btns">
        <button class="btn-cal" id="btn-cal1" onclick="toggleCal(1)">CAL 1</button>
        <button class="btn-cal" id="btn-cal2" onclick="toggleCal(2)">CAL 2</button>
      </div>
    </div>
  </div>
  <div style="display:flex;flex-direction:column;gap:12px;">
    <div class="panel">
      <div class="section-title">Texto de la lista</div>
      <div class="text-box" id="text-box">Seleccioná una lista para ver el texto.</div>
    </div>
    <div class="panel">
      <div class="section-title">Respuestas por oración — cantidad de aciertos</div>
      <table class="resp-table" id="resp-table"></table>
      <div class="divider"></div>
      <div class="results-row">
        <button class="btn-calc" onclick="calcular()">Calcular puntaje</button>
        <div class="res-card"><div class="res-label">SNR50 (dB)</div><div class="res-val" id="res1">—</div></div>
        <div class="res-card"><div class="res-label">SNRL (dB)</div><div class="res-val" id="res2">—</div></div>
      </div>
    </div>
  </div>
</div>
<audio id="audio-player"></audio>
<audio id="cal-player"></audio>
<script>
const BASE = 'https://archive.org/download/20260506_20260506_2344/';

// Prefijos segun el modo
const PREFIJOS = {
  "Auriculares":         "LISTA ",
  "Campo Libre":         "CSLISTA ",
  "Campo Libre SNR=0dB": "PDLISTA "
};

const CAL1 = BASE + 'Tono%20de%20Calibracion1_R19.wav';
const CAL2 = BASE + 'Tono%20de%20Calibracion2_R19.wav';

function urlAudio(modo, num) {
  return BASE + encodeURIComponent(PREFIJOS[modo] + num + ' REV 19.wav');
}

const LISTAS = {
